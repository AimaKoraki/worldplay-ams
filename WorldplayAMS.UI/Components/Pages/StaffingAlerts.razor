@page "/staffing-alerts"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject WorldplayAMS.UI.Services.ApiClient ApiClient
@inject IWebHostEnvironment Env

<PageTitle>Worldplay AMS — Staffing Alerts</PageTitle>

<div class="dashboard-wrap">

    <!-- Page Header -->
    <div class="dash-header">
        <div>
            <h1 class="dash-title">
                <span class="bi bi-people-fill me-3 dash-title-icon" style="color: var(--neon-purple);"></span>Staffing Recommendations
            </h1>
            <p class="dash-subtitle">Predictive staffing alerts based on historical arcade usage trends</p>
        </div>
        <div class="dash-header-actions">
            <div style="display:flex; align-items:center; gap: 0.5rem;">
                <label style="color:var(--text-secondary); font-size:0.85rem;">Baseline Staff:</label>
                <input type="number" min="1" max="20" class="form-input" style="width:70px; padding:0.3rem; background:rgba(0,0,0,0.2); border:1px solid rgba(255,255,255,0.1); color:white; border-radius:4px;" @bind="BaselineStaff" @bind:after="UpdateAlerts" />
            </div>
            <button class="btn-neon btn-neon-purple" @onclick="LoadRecommendations">
                <span class="bi bi-arrow-repeat"></span> Refresh Data
            </button>
        </div>
    </div>

    <!-- Main Content -->
    <div style="display:flex; flex-direction:column; gap:1.5rem;">

        <!-- Alerts -->
        @if (!string.IsNullOrEmpty(underStaffedWarning))
        {
            <div class="glass-alert" style="background: rgba(255,50,50,0.1); border-color: rgba(255,50,50,0.3); color: #ff8888;">
                <span class="bi bi-exclamation-triangle-fill me-2"></span> @underStaffedWarning
            </div>
        }
        @if (!string.IsNullOrEmpty(overStaffedAlert))
        {
            <div class="glass-alert" style="background: rgba(50,255,100,0.1); border-color: rgba(50,255,100,0.3); color: #88ffaa;">
                <span class="bi bi-info-circle-fill me-2"></span> @overStaffedAlert
            </div>
        }

        <!-- Heatmap Panel -->
        <section class="panel-card">
            <div class="panel-accent accent-purple"></div>
            <div class="panel-inner">
                <div class="heatmap-header">
                    <p class="section-title m-0">
                        <span class="bi bi-grid-3x3-gap text-purple"></span> Weekly Traffic Heatmap
                    </p>
                    <div class="heatmap-legend">
                        <span class="legend-label">Low</span>
                        <div class="legend-gradient"></div>
                        <span class="legend-label">High</span>
                    </div>
                </div>

                @if (isLoading)
                {
                    <div class="empty-state">
                        <span class="bi bi-hourglass-split rotating" style="font-size:2rem; color:var(--neon-purple);"></span>
                        <p class="mt-3">Analyzing historical data...</p>
                    </div>
                }
                else if (errorMessage != null)
                {
                    <div class="glass-alert">
                        <span class="bi bi-exclamation-triangle-fill me-2"></span> @errorMessage
                    </div>
                }
                else if (recommendations == null || !recommendations.Any())
                {
                    <div class="empty-state">
                        <div class="empty-icon-ring">
                            <span class="bi bi-bar-chart-line" style="font-size:2rem; color:var(--text-disabled);"></span>
                        </div>
                        <h3 class="empty-heading mt-4">No Historical Data</h3>
                        <p class="empty-desc mt-1">Not enough session history to generate recommendations.</p>
                    </div>
                }
                else
                {
                    <!-- Matrix Heatmap -->
                    <div class="heatmap-scroll">
                        <div class="heatmap-grid">

                            <!-- Top-left corner spacer -->
                            <div class="hour-label"></div>

                            <!-- Day column headers -->
                            @foreach (var day in DayNames)
                            {
                                <div class="day-header">@day</div>
                            }

                            <!-- 14 hourly rows: 09:00 – 22:00 -->
                            @for (int hour = 9; hour <= 22; hour++)
                            {
                                var h = hour;
                                <div class="hour-label">@($"{h:D2}:00")</div>

                                @foreach (var day in DayNames)
                                {
                                    var sessions  = GetSessions(day, h);
                                    var staff     = GetStaff(day, h);
                                    var intensity = MaxSessions > 0 ? (double)sessions / MaxSessions : 0;
                                    var bg        = GetCellColor(intensity);
                                    var isPeak    = sessions == MaxSessions && MaxSessions > 0;
                                    var tooltip   = $"{day} {h:D2}:00–{h+1:D2}:00 · Avg {sessions} sessions · {staff} staff recommended · {GetConfidence(day, h)}";

                                    <div class="heat-cell @(isPeak ? "heat-cell-peak" : "")"
                                         style="background: @bg;"
                                         title="@tooltip">
                                        <span class="cell-sessions">@sessions</span>
                                        <span class="cell-staff">
                                            <span class="bi bi-person-fill"></span>@staff
                                        </span>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <!-- Peak summary bar -->
                    <div class="peak-bar mt-4">
                        <div class="peak-item">
                            <span class="bi bi-fire peak-icon" style="color:var(--neon-amber);"></span>
                            <div>
                                <span class="peak-key">Peak Slot</span>
                                <span class="peak-val">@PeakDay &nbsp;·&nbsp; @PeakHour</span>
                            </div>
                        </div>
                        <div class="peak-divider"></div>
                        <div class="peak-item">
                            <span class="bi bi-people-fill peak-icon" style="color:var(--neon-cyan);"></span>
                            <div>
                                <span class="peak-key">Peak Avg Sessions</span>
                                <span class="peak-val">@MaxSessions</span>
                            </div>
                        </div>
                        <div class="peak-divider"></div>
                        <div class="peak-item">
                            <span class="bi bi-person-badge peak-icon" style="color:var(--neon-purple);"></span>
                            <div>
                                <span class="peak-key">Max Staff Required</span>
                                <span class="peak-val">@MaxStaff</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>

    </div>
</div>

<style>
    /* ── WRAPPER ───────────────────────────────────────────────── */
    .dashboard-wrap { padding-bottom: 2rem; }

    /* ── HEADER ─────────────────────────────────────────────────── */
    .dash-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
        margin-bottom: 2rem;
    }
    .dash-title {
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        color: var(--text-primary);
        margin: 0;
        display: flex;
        align-items: center;
    }
    .dash-title-icon {
        filter: drop-shadow(0 0 8px rgba(157,0,255,0.5));
    }
    .dash-subtitle {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin-top: 0.35rem;
    }

    /* ── PANEL ──────────────────────────────────────────────────── */
    .panel-card {
        background: var(--surface-base);
        border: 1px solid var(--surface-border);
        border-radius: var(--radius-md);
        overflow: hidden;
        box-shadow: var(--shadow-card);
        position: relative;
    }
    .panel-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent);
    }
    .panel-accent { height: 3px; width: 100%; }
    .accent-purple { background: linear-gradient(90deg, var(--neon-purple), transparent); }
    .panel-inner { padding: 1.75rem; }

    /* ── SECTION TITLE ──────────────────────────────────────────── */
    .section-title {
        font-family: var(--font-heading);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .text-purple { color: var(--neon-purple); }

    /* ── HEATMAP HEADER ROW ──────────────────────────────────────── */
    .heatmap-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    /* ── LEGEND ─────────────────────────────────────────────────── */
    .heatmap-legend {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }
    .legend-label {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: var(--text-secondary);
    }
    .legend-gradient {
        width: 120px;
        height: 12px;
        border-radius: 6px;
        background: linear-gradient(
            90deg,
            rgba(30,30,60,0.6)   0%,
            rgba(0,240,255,0.35) 25%,
            rgba(255,184,0,0.6)  55%,
            rgba(255,60,0,0.85)  80%,
            rgba(255,30,30,1)    100%
        );
        border: 1px solid rgba(255,255,255,0.1);
    }

    /* ── SCROLL WRAPPER ─────────────────────────────────────────── */
    .heatmap-scroll {
        overflow-x: auto;
        padding-bottom: 0.5rem;
        scrollbar-width: thin;
        scrollbar-color: rgba(157,0,255,0.4) transparent;
    }
    .heatmap-scroll::-webkit-scrollbar { height: 5px; }
    .heatmap-scroll::-webkit-scrollbar-thumb { background: rgba(157,0,255,0.4); border-radius: 3px; }

    /* ── GRID ───────────────────────────────────────────────────── */
    .heatmap-grid {
        display: grid;
        /* 1 hour-label column + 7 day columns */
        grid-template-columns: 56px repeat(7, minmax(80px, 1fr));
        gap: 3px;
        min-width: 640px;
    }

    /* ── HEADER CELLS ───────────────────────────────────────────── */
    .day-header {
        text-align: center;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--text-secondary);
        padding: 0.5rem 0.25rem;
        border-bottom: 1px solid var(--surface-border-strong);
    }
    .hour-label {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding-right: 10px;
        font-size: 0.68rem;
        font-weight: 600;
        font-family: var(--font-mono, monospace);
        color: var(--text-secondary);
        white-space: nowrap;
        user-select: none;
    }

    /* ── DATA CELLS ─────────────────────────────────────────────── */
    .heat-cell {
        position: relative;
        border-radius: 5px;
        padding: 6px 4px 5px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;
        cursor: default;
        transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
        border: 1px solid rgba(255,255,255,0.04);
        min-height: 46px;
    }
    .heat-cell:hover {
        transform: scale(1.08);
        z-index: 10;
        filter: brightness(1.25);
        box-shadow: 0 4px 16px rgba(0,0,0,0.5), 0 0 12px rgba(157,0,255,0.3);
    }

    /* Peak cell pulse ring */
    .heat-cell-peak {
        box-shadow: 0 0 0 2px rgba(255,184,0,0.7), 0 0 14px rgba(255,184,0,0.3);
        animation: peakPulse 2.2s ease-in-out infinite;
    }
    @@keyframes peakPulse {
        0%, 100% { box-shadow: 0 0 0 2px rgba(255,184,0,0.7), 0 0 14px rgba(255,184,0,0.3); }
        50%       { box-shadow: 0 0 0 3px rgba(255,184,0,0.9), 0 0 24px rgba(255,184,0,0.5); }
    }

    .cell-sessions {
        font-family: var(--font-heading);
        font-size: 0.92rem;
        font-weight: 700;
        line-height: 1;
        color: rgba(255,255,255,0.95);
        text-shadow: 0 1px 4px rgba(0,0,0,0.5);
    }
    .cell-staff {
        font-size: 0.62rem;
        font-weight: 600;
        color: rgba(255,255,255,0.6);
        display: flex;
        align-items: center;
        gap: 2px;
        text-shadow: 0 1px 3px rgba(0,0,0,0.5);
    }

    /* ── PEAK SUMMARY BAR ───────────────────────────────────────── */
    .peak-bar {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
        background: rgba(255,255,255,0.02);
        border: 1px solid var(--surface-border-strong);
        border-radius: var(--radius-md);
        padding: 1rem 1.5rem;
    }
    .peak-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .peak-icon {
        font-size: 1.4rem;
        flex-shrink: 0;
    }
    .peak-key {
        display: block;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--text-secondary);
        margin-bottom: 2px;
    }
    .peak-val {
        display: block;
        font-family: var(--font-heading);
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--text-primary);
    }
    .peak-divider {
        width: 1px;
        height: 36px;
        background: var(--surface-border-strong);
    }

    /* ── EMPTY / ALERT ──────────────────────────────────────────── */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 260px;
        color: var(--text-secondary);
        text-align: center;
        padding: 1rem;
    }
    .empty-icon-ring {
        width: 80px; height: 80px;
        border-radius: 50%;
        background: rgba(255,255,255,0.03);
        border: 1px solid var(--surface-border-strong);
        display: flex; align-items: center; justify-content: center;
    }
    .empty-heading { font-size: 1.1rem; font-weight: 700; color: var(--text-primary); }
    .empty-desc { font-size: 0.85rem; color: var(--text-secondary); max-width: 300px; }
    .glass-alert {
        background: rgba(255,50,50,0.1);
        border: 1px solid rgba(255,50,50,0.3);
        color: #ff8888;
        border-radius: 8px;
        padding: 1rem;
    }
    .rotating { animation: spin 2s linear infinite; }
    @@keyframes spin { 100% { transform: rotate(360deg); } }
</style>

@code {
    private HttpClient httpClient = default!;
    private bool isLoading = true;
    private string? errorMessage = null;
    private List<StaffingRecommendation> recommendations = new();

    private int BaselineStaff { get; set; } = 4;
    private string? underStaffedWarning;
    private string? overStaffedAlert;

    // Ordered day columns Mon → Sun
    private static readonly string[] DayNames =
        { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };

    // Quick-access lookup: (dayName, hour) → recommendation
    private Dictionary<(string Day, int Hour), StaffingRecommendation> lookup = new();

    // ── Derived stats ────────────────────────────────────────────
    private int MaxSessions => lookup.Values.Select(r => r.AverageSessions).DefaultIfEmpty(0).Max();
    private int MaxStaff    => lookup.Values.Select(r => r.RecommendedStaff).DefaultIfEmpty(0).Max();

    private string PeakDay
    {
        get
        {
            var peak = lookup.Values.OrderByDescending(r => r.AverageSessions).FirstOrDefault();
            return peak?.DayOfWeek ?? "—";
        }
    }
    private string PeakHour
    {
        get
        {
            var peak = lookup.Values.OrderByDescending(r => r.AverageSessions).FirstOrDefault();
            return peak != null ? $"{peak.Hour:D2}:00–{peak.Hour + 1:D2}:00" : "—";
        }
    }

    // ── Helpers ──────────────────────────────────────────────────
    private int GetSessions(string day, int hour) =>
        lookup.TryGetValue((day, hour), out var r) ? r.AverageSessions : 0;

    private int GetStaff(string day, int hour) =>
        lookup.TryGetValue((day, hour), out var r) ? r.RecommendedStaff : 0;

    private string GetConfidence(string day, int hour) =>
        lookup.TryGetValue((day, hour), out var r) ? r.Confidence : "";

    private void UpdateAlerts()
    {
        underStaffedWarning = null;
        overStaffedAlert = null;

        if (recommendations == null || !recommendations.Any()) return;

        var peakDeficit = recommendations
            .Where(r => r.RecommendedStaff > BaselineStaff)
            .OrderByDescending(r => r.RecommendedStaff - BaselineStaff)
            .FirstOrDefault();

        if (peakDeficit != null)
        {
            int deficit = peakDeficit.RecommendedStaff - BaselineStaff;
            underStaffedWarning = $"Under-staffed: Recommend adding {deficit} additional staff members. [{peakDeficit.Confidence}]";
        }

        double threshold = BaselineStaff * 0.30;
        int maxOptimizable = 0;
        string? overStaffedConfidence = null;

        foreach (var day in DayNames)
        {
            int consecutiveCount = 0;
            int currentOptimizable = 0;
            string? currentConfidence = null;

            for (int h = 9; h <= 22; h++)
            {
                var rec = lookup.TryGetValue((day, h), out var r) ? r : null;
                if (rec != null && rec.RecommendedStaff < threshold)
                {
                    consecutiveCount++;
                    int savings = BaselineStaff - rec.RecommendedStaff;
                    if (savings > currentOptimizable) 
                    {
                        currentOptimizable = savings;
                        currentConfidence = rec.Confidence;
                    }

                    if (consecutiveCount >= 3 && currentOptimizable > maxOptimizable)
                    {
                        maxOptimizable = currentOptimizable;
                        overStaffedConfidence = currentConfidence ?? rec.Confidence;
                    }
                }
                else
                {
                    consecutiveCount = 0;
                    currentOptimizable = 0;
                    currentConfidence = null;
                }
            }
        }

        if (maxOptimizable > 0)
        {
            overStaffedAlert = $"Over-staffed: Opportunity to optimize roster by {maxOptimizable} staff shifts. [{overStaffedConfidence}]";
        }
    }

    /// <summary>
    /// Maps intensity [0..1] to an RGBA color string:
    /// 0   → deep dark-blue (near-empty)
    /// 0.2 → muted cyan
    /// 0.5 → amber
    /// 0.8 → orange-red
    /// 1.0 → vivid red
    /// </summary>
    private static string GetCellColor(double t)
    {
        // Colour stops: (t, r, g, b, a)
        var stops = new[]
        {
            (0.00, 18,  18,  52,  0.55),
            (0.15, 0,   180, 200, 0.22),
            (0.35, 0,   200, 220, 0.42),
            (0.55, 255, 184, 0,   0.60),
            (0.75, 255, 100, 0,   0.78),
            (1.00, 255, 30,  30,  0.95),
        };

        // Find surrounding stops
        for (int i = 1; i < stops.Length; i++)
        {
            var (t0, r0, g0, b0, a0) = stops[i - 1];
            var (t1, r1, g1, b1, a1) = stops[i];
            if (t <= t1)
            {
                double f = (t - t0) / (t1 - t0);
                int r = (int)(r0 + f * (r1 - r0));
                int g = (int)(g0 + f * (g1 - g0));
                int b = (int)(b0 + f * (b1 - b0));
                double a = a0 + f * (a1 - a0);
                return $"rgba({r},{g},{b},{a:F2})";
            }
        }
        return "rgba(255,30,30,0.95)";
    }

    // ── Lifecycle ────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        httpClient = ApiClient.CreateClient();
        await LoadRecommendations();
    }

    private async Task LoadRecommendations()
    {
        isLoading = true;
        errorMessage = null;
        lookup = new();
        StateHasChanged();

        try
        {
            var response = await httpClient.GetFromJsonAsync<StaffingRecommendationResponse>(
                "/api/analytics/staffing-recommendations");

            if (response?.Recommendations != null)
            {
                recommendations = response.Recommendations;

                // Build lookup for O(1) cell access
                foreach (var rec in recommendations)
                    lookup[(rec.DayOfWeek, rec.Hour)] = rec;

                UpdateAlerts();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to connect to the analytics service. Ensure the backend API is running.";
            Console.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    // ── DTOs ─────────────────────────────────────────────────────
    private class StaffingRecommendationResponse
    {
        public List<StaffingRecommendation> Recommendations { get; set; } = new();
    }

    private class StaffingRecommendation
    {
        public string DayOfWeek     { get; set; } = string.Empty;
        public int    Hour          { get; set; }
        public string DisplayHour   { get; set; } = string.Empty;
        public int    AverageSessions { get; set; }
        public int    RecommendedStaff { get; set; }
        public string Confidence    { get; set; } = string.Empty;
    }
}
