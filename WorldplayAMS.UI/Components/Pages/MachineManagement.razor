        "Racing"   => "#00f0ff",
        "Shooter"  => "#ff3d57",
        "Fighting" => "#ff00aa",
        "Rhythm"   => "#9d00ff",
        "Sports"   => "#00e676",
        "VR"       => "#ffb800",
        "Classic"  => "#2979ff",
        "Claw"     => "#ff6e40",
        _          => "#8a95b0"
    };

