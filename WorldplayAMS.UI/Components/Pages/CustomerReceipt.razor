@page "/r/{SessionId:guid}"
@layout Layout.EmptyLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject WorldplayAMS.UI.Services.ApiClient ApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Worldplay AMS — Digital Receipt</PageTitle>

<div class="receipt-container">
    @if (isLoading)
    {
        <div class="receipt-loading">
            <div class="spinner-border text-neon-cyan" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Retrieving your receipt...</p>
        </div>
    }
    else if (receipt == null)
    {
        <div class="receipt-error glass-card">
            <span class="bi bi-exclamation-triangle text-warning mb-2" style="font-size: 2rem;"></span>
            <h3>Receipt Not Found</h3>
            <p>We couldn't find a receipt for this session. The session may still be active or the link might be invalid.</p>
        </div>
    }
    else
    {
        <!-- Action bar (hidden when printing) -->
        <div class="receipt-actions no-print mb-3" style="flex-direction: column; gap: 1rem; align-items: center;">
            <div style="display: flex; gap: 0.5rem; justify-content: center; width: 100%;">
                <button class="btn-neon btn-primary-action" @onclick="PrintReceipt">
                    <span class="bi bi-printer me-2"></span> Print / Save PDF
                </button>
                <button class="btn-neon btn-neon-cyan" @onclick="ToggleEmailForm">
                    <span class="bi bi-envelope me-2"></span> Email Receipt
                </button>
            </div>
            
            @if (showEmailForm)
            {
                <div class="email-form glass-card" style="padding: 1rem; display: flex; gap: 0.5rem; width: 100%; max-width: 350px; align-items: center; animation: fadeIn 0.3s ease;">
                    <input type="email" class="form-input" placeholder="Enter your email" @bind="emailAddress" style="flex: 1;" />
                    <button class="btn-neon btn-primary-action" @onclick="SendEmail" disabled="@isSendingEmail">
                        @if (isSendingEmail)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <span class="bi bi-send-fill me-1"></span>
                        }
                        Send
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(emailMessage))
                {
                    <div class="alert @(emailSuccess ? "alert-success" : "alert-danger") p-2 text-center w-100" style="max-width: 350px; font-size: 0.85rem; margin-top: 0.25rem;">
                        @emailMessage
                    </div>
                }
            }
        </div>

        <!-- Receipt Tape -->
        <div class="receipt-tape">
            <div class="receipt-header">
                <div class="receipt-logo">
                    <span class="bi bi-controller"></span>
                </div>
                <h2>WORLDPLAY</h2>
                <p>Arcade Management System</p>
                <div class="receipt-meta">
                    <span>Receipt #: @receipt.ReceiptNumber</span>
                    <span>Date: @receipt.IssuedAt.ToSriLankaTime().ToString("MMM dd, yyyy")</span>
                </div>
            </div>

            <div class="receipt-divider"></div>

            <div class="receipt-body">
                <div class="receipt-row">
                    <span class="r-label">Guest</span>
                    <span class="r-value">@receipt.GuestName</span>
                </div>
                <div class="receipt-row">
                    <span class="r-label">Machine</span>
                    <span class="r-value">@(receipt.MachineName ?? "Walk-in Facility")</span>
                </div>
                
                <div class="receipt-timeline mt-3">
                    <div class="time-block">
                        <span class="time-lbl">Check In</span>
                        <span class="time-val">@receipt.CheckInTime.ToSriLankaTime().ToString("hh:mm tt")</span>
                    </div>
                    <div class="time-arrow">
                        <span class="bi bi-arrow-right"></span>
                    </div>
                    <div class="time-block text-end">
                        <span class="time-lbl">Check Out</span>
                        <span class="time-val">@receipt.CheckOutTime.ToSriLankaTime().ToString("hh:mm tt")</span>
                    </div>
                </div>

                <div class="receipt-row mt-3">
                    <span class="r-label">Duration</span>
                    <span class="r-value">@receipt.DurationMinutes min</span>
                </div>
            </div>

            <div class="receipt-divider border-dashed"></div>

            <div class="receipt-footer">
                <div class="receipt-total">
                    <span class="total-lbl">TOTAL FEE</span>
                    <span class="total-val">LKR @receipt.Fee.ToString("N2")</span>
                </div>
                <p class="receipt-staff mt-3 text-muted" style="font-size: 0.8rem;">
                    Served by: @receipt.StaffName
                </p>
            </div>

            <div class="receipt-barcode mt-4">
                <!-- Decorative barcode -->
                <div class="barcode-lines"></div>
                <span class="barcode-text">@receipt.SessionId.ToString().ToUpper().Substring(0, 18)</span>
            </div>
            
            <p class="receipt-thankyou">Thank you for playing!</p>
        </div>
    }
</div>

<style>
    .receipt-container {
        width: 100%;
        max-width: 400px;
        margin: 0 auto;
    }

    .receipt-loading, .receipt-error {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--text-secondary);
    }

    .receipt-actions {
        display: flex;
        justify-content: center;
    }

    .receipt-tape {
        background: #fff;
        color: #1a1a2e;
        padding: 2.5rem 2rem;
        border-radius: 4px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        position: relative;
    }

    /* Sawtooth top and bottom */
    .receipt-tape::before, .receipt-tape::after {
        content: "";
        position: absolute;
        left: 0; right: 0;
        height: 10px;
        background-size: 20px 20px;
    }
    .receipt-tape::before {
        top: -5px;
        background-image: radial-gradient(circle at 10px 0, transparent 11px, #fff 12px);
    }
    .receipt-tape::after {
        bottom: -5px;
        background-image: radial-gradient(circle at 10px 20px, transparent 11px, #fff 12px);
    }

    .receipt-header {
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .receipt-logo {
        font-size: 2.5rem;
        color: #1a1a2e;
        margin-bottom: 0.5rem;
    }

    .receipt-header h2 {
        font-family: var(--font-heading);
        font-weight: 800;
        font-size: 1.5rem;
        margin-bottom: 0.2rem;
        letter-spacing: 2px;
    }

    .receipt-header p {
        font-size: 0.85rem;
        color: #555;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 1rem;
    }

    .receipt-meta {
        display: flex;
        flex-direction: column;
        align-items: center;
        font-size: 0.8rem;
        color: #666;
        font-family: monospace;
    }

    .receipt-divider {
        height: 2px;
        background: #1a1a2e;
        margin: 1.5rem 0;
    }
    .receipt-divider.border-dashed {
        background: transparent;
        border-top: 2px dashed #1a1a2e;
    }

    .receipt-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }
    .r-label { color: #555; }
    .r-value { font-weight: 600; text-align: right; }

    .receipt-timeline {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f4f4f8;
        padding: 0.8rem;
        border-radius: 6px;
    }
    .time-block { display: flex; flex-direction: column; }
    .time-lbl { font-size: 0.7rem; color: #777; text-transform: uppercase; margin-bottom: 0.2rem; }
    .time-val { font-weight: 600; font-size: 0.9rem; }
    .time-arrow { color: #ccc; }

    .receipt-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .total-lbl { font-size: 1.1rem; font-weight: 800; letter-spacing: 1px; }
    .total-val { font-size: 1.4rem; font-weight: 800; }

    .receipt-barcode {
        text-align: center;
    }
    .barcode-lines {
        height: 40px;
        background-image: repeating-linear-gradient(to right, #1a1a2e 0, #1a1a2e 3px, transparent 3px, transparent 5px, #1a1a2e 5px, #1a1a2e 6px, transparent 6px, transparent 10px, #1a1a2e 10px, #1a1a2e 14px, transparent 14px, transparent 16px);
        margin-bottom: 0.5rem;
        opacity: 0.8;
    }
    .barcode-text {
        font-family: monospace;
        font-size: 0.75rem;
        color: #555;
    }

    .receipt-thankyou {
        text-align: center;
        margin-top: 2rem;
        font-family: var(--font-heading);
        font-style: italic;
        color: #555;
        font-weight: 600;
    }

    /* Print styles */
    @@media print {
        html, body {
            background: #fff !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        body * {
            visibility: hidden !important;
        }

        .receipt-container,
        .receipt-container * {
            visibility: hidden !important;
        }

        .receipt-tape,
        .receipt-tape * {
            visibility: visible !important;
        }

        .empty-layout {
            padding: 0 !important;
            background: #fff !important;
            align-items: flex-start !important;
        }

        .no-print,
        .receipt-actions,
        .email-form {
            display: none !important;
        }

        .receipt-tape {
            position: fixed !important;
            inset: 0 !important;
            box-shadow: none !important;
            padding: 1.25rem 1.5rem !important;
            margin: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
            color: #000 !important;
            background: #fff !important;
            border: none !important;
            page-break-inside: avoid;
            -webkit-text-fill-color: #000 !important;
        }

        .receipt-tape * {
            color: #000 !important;
            -webkit-text-fill-color: #000 !important;
            background-color: transparent !important;
            box-shadow: none !important;
            text-shadow: none !important;
        }

        .receipt-tape::before, .receipt-tape::after { display: none !important; }
        .receipt-header,
        .receipt-body,
        .receipt-footer,
        .receipt-barcode,
        .receipt-thankyou {
            break-inside: avoid;
        }

        .receipt-header h2,
        .receipt-header p,
        .receipt-meta,
        .r-label,
        .r-value,
        .time-lbl,
        .time-val,
        .total-lbl,
        .total-val,
        .receipt-staff,
        .barcode-text,
        .receipt-thankyou {
            color: #000 !important;
            -webkit-text-fill-color: #000 !important;
        }

        @@keyframes fadeIn { from { opacity: 0; transform: translateY(-5px); } to { opacity: 1; transform: translateY(0); } }
    }
</style>

@code {
    [Parameter]
    public Guid SessionId { get; set; }

    private DigitalReceiptDto? receipt;
    private bool isLoading = true;
    
    private bool showEmailForm = false;
    private string emailAddress = string.Empty;
    private bool isSendingEmail = false;
    private string emailMessage = string.Empty;
    private bool emailSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        var client = ApiClient.CreateClient();
        try
        {
            receipt = await client.GetFromJsonAsync<DigitalReceiptDto>($"/api/receipts/{SessionId}");
        }
        catch
        {
            receipt = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PrintReceipt()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private void ToggleEmailForm()
    {
        showEmailForm = !showEmailForm;
        emailMessage = string.Empty;
    }

    private async Task SendEmail()
    {
        if (string.IsNullOrWhiteSpace(emailAddress) || !IsValidEmail(emailAddress))
        {
            emailMessage = "Please enter a valid email address (e.g. name@example.com).";
            emailSuccess = false;
            return;
        }

        isSendingEmail = true;
        emailMessage = string.Empty;

        var client = ApiClient.CreateClient();
        var request = new { Email = emailAddress };

        try
        {
            var response = await client.PostAsJsonAsync($"/api/receipts/{SessionId}/email", request);
            if (response.IsSuccessStatusCode)
            {
                emailMessage = "Receipt emailed successfully!";
                emailSuccess = true;
                emailAddress = string.Empty;
            }
            else
            {
                emailMessage = "Failed to send email. Please try again.";
                emailSuccess = false;
            }
        }
        catch
        {
            emailMessage = "An error occurred. Please try again later.";
            emailSuccess = false;
        }
        finally
        {
            isSendingEmail = false;
        }
    }

    /// <summary>
    /// Validates email using .NET's MailAddress parser — stricter than a Contains("@") check.
    /// Catches malformed addresses like "a@b", "test@", "@domain.com" before hitting the server.
    /// </summary>
    private static bool IsValidEmail(string email)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email.Trim();
        }
        catch
        {
            return false;
        }
    }

    private class DigitalReceiptDto
    {
        public Guid Id { get; set; }
        public Guid SessionId { get; set; }
        public string ReceiptNumber { get; set; } = string.Empty;
        public Guid RfidTagId { get; set; }
        public string GuestName { get; set; } = string.Empty;
        public string? MachineName { get; set; }
        public DateTime CheckInTime { get; set; }
        public DateTime CheckOutTime { get; set; }
        public int DurationMinutes { get; set; }
        public decimal Fee { get; set; }
        public string StaffName { get; set; } = string.Empty;
        public DateTime IssuedAt { get; set; }
        public string Status { get; set; } = string.Empty;
    }
}
