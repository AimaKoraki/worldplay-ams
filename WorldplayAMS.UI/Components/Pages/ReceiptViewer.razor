@page "/receipts"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using WorldplayAMS.Core.Models

<PageTitle>Worldplay AMS — Digital Receipts</PageTitle>

<div class="rcpt-wrap">

    <!-- Page Header -->
    <div class="rcpt-header">
        <div>
            <h1 class="rcpt-title">
                <span class="bi bi-file-earmark-text me-3" style="color:var(--neon-cyan);"></span>Digital Receipts
            </h1>
            <p class="rcpt-subtitle">Manager receipt viewer &amp; reconciliation</p>
        </div>
        <div class="header-actions-row">
            <button id="btn-refresh-receipts" class="btn-neon btn-neon-cyan" @onclick="RefreshAll">
                <span class="bi bi-arrow-repeat"></span> Refresh
            </button>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="filter-bar glass-card" style="padding:1rem 1.5rem;">
        <div class="filter-group">
            <label class="filter-label">From</label>
            <input id="input-rcpt-from" type="date" class="form-input filter-date" @bind="dateFrom" />
        </div>
        <div class="filter-group">
            <label class="filter-label">To</label>
            <input id="input-rcpt-to" type="date" class="form-input filter-date" @bind="dateTo" />
        </div>
        <div class="filter-quick-btns">
            <button class="btn-neon btn-quick @QuickBtnClass("today")" @onclick="QuickToday">Today</button>
            <button class="btn-neon btn-quick @QuickBtnClass("week")" @onclick="QuickWeek">This Week</button>
            <button class="btn-neon btn-quick @QuickBtnClass("month")" @onclick="QuickMonth">This Month</button>
        </div>
        <div class="filter-search-wrap">
            <span class="bi bi-search filter-search-icon"></span>
            <input id="input-rcpt-search" type="text" class="form-input filter-search" placeholder="Search receipt #, guest, or machine..." @bind="searchQuery" @bind:event="oninput" />
        </div>
        <button id="btn-apply-rcpt-filter" class="btn-primary-action btn-apply" @onclick="ApplyFilter">
            <span class="bi bi-funnel-fill"></span> Apply
        </button>
    </div>

    <!-- KPI Summary -->
    <div class="rcpt-kpi-grid">
        <div class="recon-card">
            <div class="recon-accent recon-accent-cyan"></div>
            <div class="recon-body">
                <div class="recon-icon-wrap recon-icon-cyan"><span class="bi bi-file-earmark-check"></span></div>
                <div class="recon-data">
                    <span class="recon-value">@filteredReceipts.Count</span>
                    <span class="recon-label">Receipts</span>
                </div>
            </div>
        </div>
        <div class="recon-card">
            <div class="recon-accent recon-accent-green"></div>
            <div class="recon-body">
                <div class="recon-icon-wrap recon-icon-green"><span class="bi bi-cash-coin"></span></div>
                <div class="recon-data">
                    <span class="recon-value">LKR @filteredReceipts.Sum(r => r.Fee).ToString("F2")</span>
                    <span class="recon-label">Total Revenue</span>
                </div>
            </div>
        </div>
        <div class="recon-card">
            <div class="recon-accent recon-accent-amber"></div>
            <div class="recon-body">
                <div class="recon-icon-wrap recon-icon-amber"><span class="bi bi-people-fill"></span></div>
                <div class="recon-data">
                    <span class="recon-value">@filteredReceipts.Select(r => r.GuestName).Distinct().Count()</span>
                    <span class="recon-label">Unique Guests</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Receipt Cards Grid -->
    @if (isLoading)
    {
        <div class="empty-state-full">
            <span class="bi bi-arrow-repeat rotating" style="font-size:2.5rem; color:var(--neon-cyan);"></span>
            <p class="mt-3">Loading receipts...</p>
        </div>
    }
    else if (!filteredReceipts.Any())
    {
        <div class="glass-card empty-state-full">
            <span class="bi bi-receipt" style="font-size:3rem; color:var(--text-disabled);"></span>
            <h3 class="mt-3 text-white">No Receipts Found</h3>
            <p class="mt-1 text-muted-custom">Adjust the date range or search to find receipts.</p>
        </div>
    }
    else
    {
        <div class="rcpt-grid">
            @foreach (var r in filteredReceipts)
            {
                <div class="rcpt-card glass-card" @onclick="() => SelectReceipt(r)">
                    <div class="rcpt-card-top">
                        <span class="rcpt-number">@r.ReceiptNumber</span>
                        <span class="badge-neon @(r.Status == "Issued" ? "active" : "error")">@r.Status</span>
                    </div>
                    <div class="rcpt-card-body">
                        <div class="rcpt-card-field">
                            <span class="bi bi-person-fill rcpt-field-icon"></span>
                            <span>@r.GuestName</span>
                        </div>
                        @if (!string.IsNullOrEmpty(r.MachineName))
                        {
                            <div class="rcpt-card-field">
                                <span class="bi bi-joystick rcpt-field-icon"></span>
                                <span>@r.MachineName</span>
                            </div>
                        }
                        <div class="rcpt-card-field">
                            <span class="bi bi-clock rcpt-field-icon"></span>
                            <span>@r.DurationMinutes min</span>
                        </div>
                    </div>
                    <div class="rcpt-card-footer">
                        <span class="rcpt-fee">LKR @r.Fee.ToString("F2")</span>
                        <span class="rcpt-date">@r.IssuedAt.ToSriLankaTime().ToString("MMM dd, HH:mm")</span>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Receipt Detail Panel -->
    @if (selectedReceipt != null)
    {
        <div class="rcpt-overlay" @onclick="CloseDetail"></div>
        <div class="rcpt-detail-panel glass-card">
            <div class="rcpt-detail-header">
                <h3 class="rcpt-detail-title">
                    <span class="bi bi-file-earmark-text text-cyan"></span> Receipt Detail
                </h3>
                <div style="display:flex; gap:0.5rem;">
                    <button class="btn-neon btn-neon-cyan" style="font-size:0.75rem; padding:0.4rem 0.8rem;" @onclick="CopyPublicLink">
                        <span class="bi bi-link-45deg"></span> Link
                    </button>
                    <button class="btn-neon btn-neon-green" style="font-size:0.75rem; padding:0.4rem 0.8rem;" @onclick="PrintReceipt">
                        <span class="bi bi-printer"></span> Print / PDF
                    </button>
                    <button class="btn-neon btn-neon-red btn-sm" @onclick="CloseDetail">
                        <span class="bi bi-x-lg"></span>
                    </button>
                </div>
            </div>

            <!-- Branded receipt (id required for print scope) -->
            <div class="receipt-paper" id="printable-receipt">
                <div class="receipt-brand">
                    <div class="receipt-logo"><span class="bi bi-controller"></span></div>
                    <div>
                        <h2 class="receipt-brand-name">Worldplay</h2>
                        <p class="receipt-brand-sub">Arcade Management System</p>
                    </div>
                </div>

                <div class="receipt-divider"></div>

                <div class="receipt-number-row">
                    <span class="receipt-num-label">RECEIPT</span>
                    <span class="receipt-num-value">@selectedReceipt.ReceiptNumber</span>
                </div>

                <div class="receipt-divider"></div>

                <div class="receipt-field-grid">
                    <div class="receipt-field">
                        <span class="receipt-field-label">Guest Name</span>
                        <span class="receipt-field-value">@selectedReceipt.GuestName</span>
                    </div>
                    @if (!string.IsNullOrEmpty(selectedReceipt.MachineName))
                    {
                        <div class="receipt-field">
                            <span class="receipt-field-label">Machine Used</span>
                            <span class="receipt-field-value">@selectedReceipt.MachineName</span>
                        </div>
                    }
                    <div class="receipt-field">
                        <span class="receipt-field-label">RFID Tag</span>
                        <span class="receipt-field-value font-mono">@selectedReceipt.RfidTagId.ToString()[..8].ToUpper()</span>
                    </div>
                    <div class="receipt-field">
                        <span class="receipt-field-label">Session ID</span>
                        <span class="receipt-field-value font-mono">@selectedReceipt.SessionId.ToString()[..8].ToUpper()</span>
                    </div>
                    <div class="receipt-field">
                        <span class="receipt-field-label">Check-In</span>
                        <span class="receipt-field-value">@selectedReceipt.CheckInTime.ToSriLankaTime().ToString("MMM dd yyyy, HH:mm")</span>
                    </div>
                    <div class="receipt-field">
                        <span class="receipt-field-label">Check-Out</span>
                        <span class="receipt-field-value">@selectedReceipt.CheckOutTime.ToSriLankaTime().ToString("MMM dd yyyy, HH:mm")</span>
                    </div>
                    <div class="receipt-field">
                        <span class="receipt-field-label">Duration</span>
                        <span class="receipt-field-value">@selectedReceipt.DurationMinutes min</span>
                    </div>
                    <div class="receipt-field">
                        <span class="receipt-field-label">Processed By</span>
                        <span class="receipt-field-value">@selectedReceipt.StaffName</span>
                    </div>
                </div>

                <div class="receipt-divider"></div>

                <div class="receipt-total-row">
                    <span>TOTAL</span>
                    <span class="receipt-total-value">LKR @selectedReceipt.Fee.ToString("F2")</span>
                </div>

                <div class="receipt-divider"></div>

                <div class="receipt-footer-info">
                    <span class="badge-neon @(selectedReceipt.Status == "Issued" ? "active" : "error")">
                        <span class="bi @(selectedReceipt.Status == "Issued" ? "bi-check-circle-fill" : "bi-x-circle-fill")"></span>
                        @selectedReceipt.Status
                    </span>
                    <span class="receipt-issued-at">Issued: @selectedReceipt.IssuedAt.ToSriLankaTime().ToString("MMM dd yyyy, HH:mm:ss")</span>
                </div>
            </div>
        </div>
    }
</div>
