    private string GetSortIcon(string column)
    {
        if (sortColumn != column) return "bi-chevron-expand";
        return sortAscending ? "bi-chevron-up" : "bi-chevron-down";
    }

    private async Task ExportCsv()
    {
        if (!filteredTransactions.Any()) return;

        var csv = "Session ID,Tag ID,Check-In,Check-Out,Duration (min),Fee (LKR),Staff,Status\n";
        foreach (var t in filteredTransactions)
        {
            var staff = t.CheckedOutByStaff ?? "N/A";
            csv += $"{t.Id},{t.RfidTagId},{t.StartTime:o},{t.EndTime:o},{t.TotalDurationMinutes ?? 0},{(t.Fee ?? 0):F2},{staff},Completed\n";
        }

        // Trigger download via JS interop
        var bytes = System.Text.Encoding.UTF8.GetBytes(csv);
        var base64 = Convert.ToBase64String(bytes);
        Nav.NavigateTo($"data:text/csv;base64,{base64}", true);

        // Log audit
        await LogAuditAction("ExportedCSV", $"Exported {filteredTransactions.Count} transactions ({dateFrom:yyyy-MM-dd} to {dateTo:yyyy-MM-dd})");
        await LoadAuditLogs();
    }

