@using WorldplayAMS.UI.Auth
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="brand-header">
    <a class="navbar-brand" href="">
        <div class="brand-logo">
            <span class="bi bi-controller"></span>
        </div>
        <div class="brand-name">
            <span class="brand-main">Worldplay</span>
            <span class="brand-sub">AMS &nbsp;v2.0</span>
        </div>
    </a>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav>
        <AuthorizeView>
            <Authorized Context="authContext">

                <span class="nav-section-label">Navigation</span>

                <div class="nav-item mb-1">
                    <NavLink class="glass-nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-grid-1x2-fill nav-icon"></span>
                        Dashboard
                    </NavLink>
                </div>

                <AuthorizeView Roles="Admin,Staff" Context="staffContext">
                    <div class="nav-item mb-1">
                        <NavLink class="glass-nav-link" href="scanner">
                            <span class="bi bi-radar nav-icon"></span>
                            Check-In Scanner
                        </NavLink>
                    </div>
                    <div class="nav-item mb-1">
                        <NavLink class="glass-nav-link" href="sessions">
                            <span class="bi bi-clock-history nav-icon"></span>
                            Session History
                        </NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Roles="Admin" Context="adminContext">
                    <span class="nav-section-label" style="margin-top:0.75rem;">Management</span>
                    <div class="nav-item mb-1">
                        <NavLink class="glass-nav-link" href="transactions">
                            <span class="bi bi-receipt-cutoff nav-icon"></span>
                            Transaction History
                        </NavLink>
                    </div>
                    <div class="nav-item mb-1">
                        <NavLink class="glass-nav-link" href="receipts">
                            <span class="bi bi-file-earmark-text nav-icon"></span>
                            Digital Receipts
                        </NavLink>
                    </div>
                    <div class="nav-item mb-1">
                        <NavLink class="glass-nav-link" href="admin/machines">
                            <span class="bi bi-joystick nav-icon"></span>
                            Machine Management
                        </NavLink>
                    </div>
                    <div class="nav-item mb-1">
                        <NavLink class="glass-nav-link" href="admin/staff">
                            <span class="bi bi-people-fill nav-icon"></span>
                            Staff Management
                        </NavLink>
                    </div>
                    <div class="nav-item mb-1">
                        <NavLink class="glass-nav-link" href="staffing-alerts">
                            <span class="bi bi-calendar-week nav-icon"></span>
                            Staffing Alerts
                        </NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Roles="Admin,Manager" Context="managerContext">
                    <span class="nav-section-label" style="margin-top:0.75rem;">Intelligence</span>
                    <div class="nav-item mb-1">
                        <NavLink class="glass-nav-link" href="attraction-analytics">
                            <span class="bi bi-bar-chart-fill nav-icon"></span>
                            Attraction Analytics
                        </NavLink>
                    </div>
                    <div class="nav-item mb-1">
                        <NavLink class="glass-nav-link" href="peak-hours">
                            <span class="bi bi-grid-3x3-gap-fill nav-icon"></span>
                            Peak Hours
                        </NavLink>
                    </div>
                    <div class="nav-item mb-1">
                        <NavLink class="glass-nav-link" href="export">
                            <span class="bi bi-cloud-download-fill nav-icon"></span>
                            Data Export
                        </NavLink>
                    </div>
                </AuthorizeView>
                <AuthorizeView Roles="Admin,Technician" Context="techContext">
                    <div class="nav-item mb-1">
                        <NavLink class="glass-nav-link" href="technician">
                            <span class="bi bi-gpu-card nav-icon"></span>
                            Diagnostics
                        </NavLink>
                    </div>
                    <div class="nav-item mb-1">
                        <NavLink class="glass-nav-link" href="asset-logs">
                            <span class="bi bi-hdd-stack-fill nav-icon"></span>
                            Asset Logs
                        </NavLink>
                    </div>
                </AuthorizeView>

                <!-- Spacer pushes sign-out to the bottom -->
                <div class="nav-bottom-spacer"></div>

                <div class="nav-divider"></div>

                <div class="nav-item mb-1">
                    <button class="glass-nav-link btn-logout" @onclick="Logout">
                        <span class="bi bi-box-arrow-left nav-icon"></span>
                        Sign Out
                    </button>
                </div>

            </Authorized>
            <NotAuthorized Context="notAuthContext">
                <span class="nav-section-label">Access</span>
                <div class="nav-item mb-1">
                    <NavLink class="glass-nav-link" href="login">
                        <span class="bi bi-fingerprint nav-icon"></span>
                        Authenticate
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private async Task Logout()
    {
        if (AuthStateProvider is WorldplayAMS.UI.Auth.SupabaseAuthStateProvider supabaseProvider)
        {
            await supabaseProvider.LogoutAsync();
        }
        else if (AuthStateProvider is WorldplayAMS.UI.Auth.SimulatedAuthStateProvider simulatedProvider)
        {
            await simulatedProvider.LogoutAsync();
        }

        Nav.NavigateTo("/login", forceLoad: true);
    }
}
